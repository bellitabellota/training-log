<div class="grid grid-cols-[0.5fr_1fr_1fr] gap-x-2 gap-y-1">
  <div></div>
  <div class="text-center p-px font-semibold">Reps</div>
  <div class="text-center p-px font-semibold">Weight</div>

  <%= planned_exercises_form.fields_for :planned_sets do |planned_set_form| %>
    <div class="p-px text-sm">
      Set&nbsp;<%= planned_set_form.object.set_number %>
      <%= planned_set_form.hidden_field :set_number %>
    </div>

    <div class="p-px text-sm rounded-3xl bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500">
      <%= planned_set_form.number_field :reps, min: 0, step: 1, class: "w-full text-center rounded-xl py-[1px] bg-white rounded-[calc(1.5rem-1px)] focus:outline-[1px]" %>
    </div>

    <div class="p-px text-sm rounded-3xl bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500">
      <%= planned_set_form.number_field :weight, in: 0.25..10000.00, step: 0.25, class: "w-full text-center rounded-xl py-[1px] bg-white rounded-[calc(1.5rem-1px)] focus:outline-[1px]" %>
    </div>
  <% end %>
</div>