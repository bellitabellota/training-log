<h1>TrainingTemplate#new</h1>

<%= form_with model: @training_template do |form| %>
  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  
  <%= form.fields_for :planned_exercises do | planned_exercises_form |%>
    <%= planned_exercises_form.hidden_field :position %>
    <div class="border">
      <%= planned_exercises_form.label :exercise_id, "Exercise" %>
      <%= planned_exercises_form.select :exercise_id, @exercise_options %> 
     
      <%= planned_exercises_form.fields_for :planned_sets do |  planned_set_form |%> 
        <div class="border">
          <div>
            <p>Set <%= planned_set_form.object.set_number %></p>

            <%= planned_set_form.hidden_field :set_number %>
          </div>
          <div>
            <%= planned_set_form.label :reps %>
            <%= planned_set_form.number_field :reps, min: 0, step: 1 %>
          </div>
          <div>
            <%= planned_set_form.label :weight %>
            <%= planned_set_form.number_field :weight, in: 0.25..10000.00, step: 0.25 %>
          </div>
          <div>
            <%= planned_set_form.label :duration_seconds, "Duration (seconds)" %>
            <%= planned_set_form.number_field :duration_seconds %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<%= form.submit %>
<% end %>


