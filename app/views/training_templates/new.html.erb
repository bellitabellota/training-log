<div class="max-w-sm my-6 mx-auto p-6 space-y-4 shadow-md bg-[oklch(98.5%_0_0)]">
  <h1 class="text-center text-xl font-semibold">Create A New Training Template</h1>
  
  <%= form_with model: @training_template, class: "p-1 space-y-4" do |form| %>
    <% if form.object.errors.any? %>
      <p class="error"><%= form.object.errors.full_messages.first %></p>
    <% end %>
  
    <div>
      <%= form.label :name, "Template Name" %>
      <%= gradient_input_wrapper do %>
        <%= form.text_field :name, class: "px-2 focus:outline-[1px]" %>
      <% end %>
    </div>

    <%= form.fields_for :planned_exercises do | planned_exercises_form |%>
      <%= planned_exercises_form.hidden_field :position %>
      <%= gradient_border_form_section do %>
        <div data-controller="form-exercise-type">
          <div class="px-2 py-1">
            <%= planned_exercises_form.label :exercise_id, "Exercise" , class: "font-bold text-lg" %>
            <%= gradient_input_wrapper do %>
              <%= planned_exercises_form.select :exercise_id, @exercise_options, { include_blank: "Select an exercise" }, data: { action: "change->form-exercise-type#toggle", form_exercise_type_target: "select" } %>
            <% end %>
          </div>
          <div data-form-exercise-type-target="weight">
            <%= render "form_table_weight_exercises", planned_exercises_form: planned_exercises_form %>
          </div>
          <div class="hidden" data-form-exercise-type-target="time">
            <%= render "form_table_time_exercises", planned_exercises_form: planned_exercises_form %>
          </div>
        </div>
      <% end %>
    <% end %>
    <%= gradient_form_submit(form) %>
  <% end %>
</div>